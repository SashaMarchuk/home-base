{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [ { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/session-start" } ] }
    ],
    "PreToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/codex-pre-tool" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/session-end --surface codex", "timeout": 3 } ] }
    ]
  }
}
