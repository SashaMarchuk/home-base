# shellcheck shell=bash
# Fake terminal backend for scripts/term/term.sh. Sourced when TERM_SH_BACKEND=fake.
# Every tab is a folder $TERM_FAKE_DIR/tabs/<tty>/ holding small files:
#   tab     tab id                     mode    claude | codex | shell | closed
#           (a codex tab is drawn with the same box: the real Codex screen is not modelled; it ends on /quit)
#   body    text above the input box   box     what is typed in the box
#   ghost   a suggestion shown while the box is empty (typing replaces it)
#   placeholder  a hint shown whenever the box is empty (it comes back after the text is deleted)
#   dialog  an open dialog (rows "N. label"); free-text focus in "freetext", typed text in "answer"
#   headsup a notice with "0: Dismiss" busy  a running turn ("esc to interrupt")
#   status  status line under the box  swallow  how many next Enters are lost
#   linger  the process survives /exit pid  the process of the session
#   drop-typing  typed text is lost (a silently dropped write)
#   sticky-dialog  Esc leaves the dialog open
#   window  the window id of the tab (default w1)
#   on-submit  a script run with the submitted line as $1 (stands in for the session acting on it)
#   on-key     a script run with the key name (cr, esc, bs) as $1 after the key took effect
#   on-screen  a script run before each screen read (stands in for a session that changes on its own)
# $TERM_FAKE_DIR/on-first-key: a script run once, before the first key reaches any tab
# Logs: keys (every keystroke), sent (submitted lines), answered (dialog answers).
# Processes are folders $TERM_FAKE_DIR/proc/<pid>/ with cmd, tty, cwd and ppid; kills go to $TERM_FAKE_DIR/kills.
# $TERM_FAKE_DIR/self-pid is the pid term.sh sees as its own (start of the walk to the calling
# session; none when absent); $TERM_FAKE_DIR/front-window the frontmost window; windows are
# created as w<N> and logged to $TERM_FAKE_DIR/windows.

[ -n "${TERM_FAKE_DIR:-}" ] || { echo "term-fake: TERM_FAKE_DIR is not set" >&2; exit 2; }
mkdir -p "$TERM_FAKE_DIR/tabs" "$TERM_FAKE_DIR/proc"

fake_tab() { printf '%s/tabs/%s' "$TERM_FAKE_DIR" "$1"; }
fake_get() { cat "$(fake_tab "$1")/$2" 2>/dev/null; }
fake_put() { printf '%s' "$3" > "$(fake_tab "$1")/$2"; }
fake_live() { # fake_live <tty> <tab>
  local d; d=$(fake_tab "$1")
  [ -d "$d" ] && [ "$(fake_get "$1" mode)" != closed ] || return 1
  [ -z "$2" ] || [ "$(fake_get "$1" tab)" = "$2" ]
}

fake_first_key() { # the first key of the run into any tab: run the global hook once, before the key lands
  [ -f "$TERM_FAKE_DIR/on-first-key" ] && [ ! -f "$TERM_FAKE_DIR/first-key-seen" ] || return 0
  : > "$TERM_FAKE_DIR/first-key-seen"
  /bin/bash "$TERM_FAKE_DIR/on-first-key" >/dev/null 2>&1
}

be_screen() {
  local d mode box ghost
  fake_live "$1" "$2" || return 4
  d=$(fake_tab "$1"); mode=$(fake_get "$1" mode)
  [ -f "$d/on-screen" ] && /bin/bash "$d/on-screen" >/dev/null 2>&1
  [ -f "$d/body" ] && cat "$d/body"
  if [ "$mode" = shell ]; then printf '$ %s\n' "$(fake_get "$1" box)"; return 0; fi
  [ -f "$d/headsup" ] && cat "$d/headsup"
  if [ -f "$d/dialog" ]; then
    cat "$d/dialog"
    [ -f "$d/freetext" ] && printf '   > %s\n' "$(fake_get "$1" answer)"
    return 0
  fi
  [ -f "$d/busy" ] && printf '* Working... (esc to interrupt)\n'
  box=$(fake_get "$1" box); ghost=$(fake_get "$1" ghost)
  [ -z "$box" ] && [ -n "$ghost" ] && box=$ghost
  [ -z "$box" ] && [ -f "$d/placeholder" ] && box=$(cat "$d/placeholder")
  printf '%s\n' "--------------------------------------------------" | sed "s/-/$RULE/g"
  printf '%s %s\n' "$PROMPT" "$box"
  printf '%s\n' "--------------------------------------------------" | sed "s/-/$RULE/g"
  printf '  %s\n' "$(fake_get "$1" status)"
  printf '\n\n'
}

be_type() {
  local d mode n
  fake_live "$1" "$2" || return 4
  d=$(fake_tab "$1"); mode=$(fake_get "$1" mode)
  fake_first_key
  printf 'type:%s\n' "$3" >> "$d/keys"
  [ -f "$d/drop-typing" ] && return 0
  [ "$mode" = codex ] && mode=claude
  if [ "$mode" = claude ] && [ -f "$d/dialog" ]; then
    if [ -f "$d/freetext" ]; then fake_put "$1" answer "$(fake_get "$1" answer)$3"; return 0; fi
    case "$3" in
      [0-9]) n=$3
        grep -Eq "^[^0-9]*$n\.[[:space:]]+(Type something|Other)" "$d/dialog" && : > "$d/freetext" ;;
    esac
    return 0
  fi
  if [ "$mode" = claude ] && [ -f "$d/headsup" ] && [ "$3" = 0 ]; then rm -f "$d/headsup"; return 0; fi
  rm -f "$d/ghost"
  fake_put "$1" box "$(fake_get "$1" box)$3"
}

be_key() {
  local d mode line s pid
  fake_live "$1" "$2" || return 4
  d=$(fake_tab "$1"); mode=$(fake_get "$1" mode)
  fake_first_key
  printf 'key:%s\n' "$3" >> "$d/keys"
  fake_key "$@"; local rc=$?
  [ -f "$d/on-key" ] && /bin/bash "$d/on-key" "$3" >/dev/null 2>&1
  return $rc
}

fake_key() { # the effect of one key on the tab
  local d mode line s pid
  d=$(fake_tab "$1"); mode=$(fake_get "$1" mode)
  case "$3" in
    bs)
      if [ -f "$d/freetext" ]; then line=$(fake_get "$1" answer); fake_put "$1" answer "${line%?}"
      else line=$(fake_get "$1" box); fake_put "$1" box "${line%?}"; fi ;;
    esc)
      if [ -f "$d/dialog" ] && [ -f "$d/sticky-dialog" ]; then :
      elif [ -f "$d/dialog" ]; then rm -f "$d/dialog" "$d/freetext" "$d/answer"
      else rm -f "$d/busy"; fi ;;
    cr)
      if { [ "$mode" = claude ] || [ "$mode" = codex ]; } && [ -f "$d/dialog" ]; then
        if [ -f "$d/freetext" ]; then fake_get "$1" answer >> "$d/answered"; echo >> "$d/answered"
        else echo "option-1" >> "$d/answered"; fi
        rm -f "$d/dialog" "$d/freetext" "$d/answer"; return 0
      fi
      s=$(fake_get "$1" swallow); s=${s:-0}
      if [ "$s" -gt 0 ]; then fake_put "$1" swallow "$((s - 1))"; return 0; fi
      line=$(fake_get "$1" box)
      printf '%s\n' "$line" >> "$d/sent"
      fake_put "$1" box ""; rm -f "$d/ghost"
      [ -f "$d/on-submit" ] && /bin/bash "$d/on-submit" "$line" >/dev/null 2>&1
      if { [ "$mode" = claude ] && [ "$line" = /exit ]; } || { [ "$mode" = codex ] && [ "$line" = /quit ]; }; then
        fake_put "$1" mode shell
        pid=$(fake_get "$1" pid)
        [ -f "$d/linger" ] || rm -rf "$TERM_FAKE_DIR/proc/$pid"
      elif [ "$mode" = shell ] && [ "$line" = exit ]; then
        fake_put "$1" mode closed
      fi ;;
  esac
}

be_open() { # mirrors the real launch: the tab starts with "<shell> -lic '<wrapper>'" [<window id>|new|current]; no key is typed
  # A command of another shape opens nothing. The wrapper's own decode pipeline is run to get the launch line
  # "cd '<dir>' && <command>". The focus: the new tab is in front for a moment, then the old front tab is again
  # (logged to $TERM_FAKE_DIR/focus; $TERM_FAKE_DIR/front-tab holds the front tab).
  # Fixtures: open-fail (the create fails), wrapper-holds-line (the shell's command line holds the launch line
  # and gets a higher pid), no-agent (only the shell starts), on-open (a script run with the tty, the pid and
  # the launch line once the session's process exists: stands in for the session writing its session file).
  local n=1 tty pid cmd cwd d w=${2:-current} m=1 dec line front
  [ -f "$TERM_FAKE_DIR/open-fail" ] && return 1
  printf '%s\n' "$1" | grep -Eq "^/[A-Za-z0-9_./-]+ -lic 'eval \"\\\$\(printf %s ([0-9a-f][0-9a-f])+ \| /[A-Za-z0-9_./-]+ -e \"print pack\(q\(H\*\),<STDIN>\)\"\)\"; exec /[A-Za-z0-9_./-]+ -l'\$" || return 1
  dec=$(printf '%s\n' "$1" | sed -n 's/.*eval "\$(\(.*\))"; exec .*/\1/p')   # the wrapper's own decode pipeline, run as the tab's shell would
  line=$(/bin/bash -c "$dec") || return 1
  [ -n "$line" ] || return 1
  while ! mkdir "$TERM_FAKE_DIR/tabs/ttyf$n" 2>/dev/null; do n=$((n + 1)); done
  tty=ttyf$n; d=$(fake_tab "$tty"); pid=$((60000 + n))
  case "$w" in
    new) while grep -qx "w$m" "$TERM_FAKE_DIR/windows" 2>/dev/null || fake_window_live "w$m"; do m=$((m + 1)); done
         w=w$m; echo "$w" >> "$TERM_FAKE_DIR/windows" ;;
    current) w=$(cat "$TERM_FAKE_DIR/front-window" 2>/dev/null || echo w1) ;;
    *) fake_window_live "$w" || { rmdir "$d"; return 1; } ;;
  esac
  printf 'fake-%s' "$n" > "$d/tab"; printf 'claude' > "$d/mode"; : > "$d/box"; printf '%s' "$w" > "$d/window"
  front=$(cat "$TERM_FAKE_DIR/front-tab" 2>/dev/null)
  printf '%s' "$tty" > "$TERM_FAKE_DIR/front-tab"; printf '%s -> %s' "${front:-none}" "$tty" >> "$TERM_FAKE_DIR/focus"   # the new tab takes the focus
  printf '%s' "$front" > "$TERM_FAKE_DIR/front-tab"; printf ' -> %s\n' "${front:-none}" >> "$TERM_FAKE_DIR/focus"       # and it is given back
  printf '%s\n' "$1" >> "$TERM_FAKE_DIR/commands"
  printf '%s\n' "$line" >> "$TERM_FAKE_DIR/launches"
  printf '%s %s\n' "$tty" "$w" >> "$TERM_FAKE_DIR/placed"
  printf '%s' "$line" > "$d/launch"
  cmd=$(printf '%s' "${line#* && }" | tr -d "'")   # the shell removes the quotes before the process starts
  cwd=$(printf '%s' "$line" | sed -n "s/^cd '\\([^']*\\)' && .*/\\1/p")
  case "$cmd" in codex|codex\ *) printf 'codex' > "$d/mode" ;; esac
  printf '%s' "$pid" > "$d/pid"
  mkdir -p "$TERM_FAKE_DIR/proc/$((pid + 5000))"   # the shell around the session
  if [ -f "$TERM_FAKE_DIR/wrapper-holds-line" ]; then printf '/bin/zsh -lic %s' "$cmd" > "$TERM_FAKE_DIR/proc/$((pid + 5000))/cmd"
  else printf '%s' "$1" > "$TERM_FAKE_DIR/proc/$((pid + 5000))/cmd"; fi
  printf '%s' "$tty" > "$TERM_FAKE_DIR/proc/$((pid + 5000))/tty"
  printf '%s' "$cwd" > "$TERM_FAKE_DIR/proc/$((pid + 5000))/cwd"
  if [ ! -f "$TERM_FAKE_DIR/no-agent" ]; then
    mkdir -p "$TERM_FAKE_DIR/proc/$pid"
    printf '%s' "$cmd" > "$TERM_FAKE_DIR/proc/$pid/cmd"
    printf '%s' "$tty" > "$TERM_FAKE_DIR/proc/$pid/tty"
    printf '%s' "$cwd" > "$TERM_FAKE_DIR/proc/$pid/cwd"
  fi
  [ -f "$TERM_FAKE_DIR/on-open" ] && /bin/bash "$TERM_FAKE_DIR/on-open" "$tty" "$pid" "$line" >/dev/null 2>&1
  echo "fake-$n $tty $w"
}

fake_window_live() { be_tabs | awk -v w="$1" '$3 == w { f = 1 } END { exit !f }'; }

be_tabs() {
  local d t
  for d in "$TERM_FAKE_DIR"/tabs/*; do
    [ -d "$d" ] || continue
    t=${d##*/}
    [ "$(fake_get "$t" mode)" = closed ] && continue
    [ -f "$d/tab" ] || continue
    echo "$(cat "$d/tab") $t $(cat "$d/window" 2>/dev/null || echo w1)"
  done
}

be_procs() {
  local d
  for d in "$TERM_FAKE_DIR"/proc/*; do
    [ -d "$d" ] || continue
    echo "${d##*/} $(cat "$d/tty") $(cat "$d/cmd")"
  done
}
be_pid_cmd() { [ -f "$TERM_FAKE_DIR/proc/$1/cmd" ] || return 1; cat "$TERM_FAKE_DIR/proc/$1/cmd"; echo; }
be_pid_tty() { cat "$TERM_FAKE_DIR/proc/$1/tty" 2>/dev/null; }
be_pid_cwd() { cat "$TERM_FAKE_DIR/proc/$1/cwd" 2>/dev/null; }
be_pid_ppid() { cat "$TERM_FAKE_DIR/proc/$1/ppid" 2>/dev/null; }
be_self_pid() { cat "$TERM_FAKE_DIR/self-pid" 2>/dev/null || echo 0; }
be_front_window() { cat "$TERM_FAKE_DIR/front-window" 2>/dev/null || echo w1; }
be_kill() { echo "$1" >> "$TERM_FAKE_DIR/kills"; rm -rf "$TERM_FAKE_DIR/proc/$1"; }
be_mem_free() { cat "$TERM_FAKE_DIR/mem_free" 2>/dev/null || echo 80; }
be_uuid() { uuidgen | tr 'A-Z' 'a-z'; }
be_codex_threads() { # the thread list as lines "id|created_at|archived|source|cwd" in $TERM_FAKE_DIR/codex-threads; unreadable when absent
  [ -f "$TERM_FAKE_DIR/codex-threads" ] || return 1
  tr '|' "$US" < "$TERM_FAKE_DIR/codex-threads"
}
