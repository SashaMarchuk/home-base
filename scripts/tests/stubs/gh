#!/usr/bin/env python3
"""Fake `gh` for tests and replays. No network.

Implements the REST routes the home scripts use through `gh api`, plus
`gh label create`, `gh api user`, and the porcelain issue verbs
`gh issue create|list|view|comment|close|reopen|edit` (repo from -R/--repo or
$GH_REPO), all over the same issue files. State lives in $GH_STUB_DIR (required):
  <dir>/<owner>__<repo>/issues/<n>.json   one issue with its comments
  <dir>/calls.log                          one JSON line per call
Login: $GH_STUB_LOGIN (default "owner"). Errors exit 1 with a message on stderr,
like the real CLI. A call matching the regex $GH_STUB_FAIL_MATCH fails with
$GH_STUB_FAIL_MESSAGE (default an HTTP 502).
"""
import fcntl, json, os, re, subprocess, sys, time
from datetime import datetime, timezone
from urllib.parse import urlsplit, parse_qs, unquote

D = os.environ.get("GH_STUB_DIR")
if not D:
    sys.stderr.write("gh stub: GH_STUB_DIR is not set\n"); sys.exit(1)
os.makedirs(D, exist_ok=True)
LOGIN = os.environ.get("GH_STUB_LOGIN", "owner")


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def log(argv, verdict):
    line = json.dumps({"ts": now(), "tool": "gh", "argv": argv, "verdict": verdict})
    for p in [os.path.join(D, "calls.log"), os.environ.get("STUB_CALLS_JSONL")]:
        if p:
            with open(p, "a") as f:
                f.write(line + "\n")


def die(msg, code=1):
    sys.stderr.write(msg.rstrip() + "\n"); sys.exit(code)


class Store:
    def __init__(self):
        self.lockf = open(os.path.join(D, ".lock"), "w")
        fcntl.flock(self.lockf, fcntl.LOCK_EX)

    def rdir(self, owner, repo):
        p = os.path.join(D, f"{owner}__{repo}", "issues")
        os.makedirs(p, exist_ok=True)
        return p

    def next_id(self, name):
        p = os.path.join(D, name)
        n = int(open(p).read()) + 1 if os.path.exists(p) else 1
        open(p, "w").write(str(n))
        return n

    def issues(self, owner, repo):
        p = self.rdir(owner, repo)
        out = []
        for f in sorted(os.listdir(p), key=lambda x: int(x.split(".")[0])):
            out.append(json.load(open(os.path.join(p, f))))
        return out

    def get(self, owner, repo, n):
        p = os.path.join(self.rdir(owner, repo), f"{n}.json")
        if not os.path.exists(p):
            die("gh: Not Found (HTTP 404)")
        return json.load(open(p))

    def put(self, owner, repo, issue):
        p = os.path.join(self.rdir(owner, repo), f"{issue['number']}.json")
        json.dump(issue, open(p, "w"), indent=1)

    def labels_path(self, owner, repo):
        return os.path.join(D, f"{owner}__{repo}", "labels.json")

    def labels(self, owner, repo):
        p = self.labels_path(owner, repo)
        return json.load(open(p)) if os.path.exists(p) else []

    def set_labels(self, owner, repo, labels):
        os.makedirs(os.path.dirname(self.labels_path(owner, repo)), exist_ok=True)
        json.dump(labels, open(self.labels_path(owner, repo), "w"), indent=1)

    def find_comment(self, owner, repo, cid):
        for i in self.issues(owner, repo):
            for c in i["comments"]:
                if c["id"] == cid:
                    return i, c
        die("gh: Not Found (HTTP 404)")


def public_issue(owner, repo, i):
    o = {k: v for k, v in i.items() if k != "comments"}
    o["comments"] = len(i["comments"])
    o["labels"] = [{"name": n} for n in i["labels"]]
    o["html_url"] = f"https://github.com/{owner}/{repo}/issues/{i['number']}"
    o["repository_url"] = f"https://api.github.com/repos/{owner}/{repo}"
    o["user"] = {"login": i.get("author", LOGIN)}
    return o


def public_comment(owner, repo, i, c):
    o = dict(c)
    o["user"] = {"login": c.get("author", LOGIN)}
    o["html_url"] = f"https://github.com/{owner}/{repo}/issues/{i['number']}#issuecomment-{c['id']}"
    o["issue_url"] = f"https://api.github.com/repos/{owner}/{repo}/issues/{i['number']}"
    return o


def typed(v):
    if v in ("true", "false"):
        return v == "true"
    if v == "null":
        return None
    if re.fullmatch(r"-?\d+", v):
        return int(v)
    if v.startswith("@"):
        return open(v[1:]).read()
    return v


def parse_fields(pairs):
    body = {}
    for raw, kind in pairs:
        k, _, v = raw.partition("=")
        val = typed(v) if kind == "F" else v
        if k.endswith("[]"):
            body.setdefault(k[:-2], []).append(val)
        else:
            body[k] = val
    return body


def api(argv):
    method, fields, jq, inp, endpoint = None, [], None, None, None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-X", "--method"):
            method = argv[i + 1].upper(); i += 2; continue
        if a in ("-f", "--raw-field"):
            fields.append((argv[i + 1], "f")); i += 2; continue
        if a in ("-F", "--field"):
            fields.append((argv[i + 1], "F")); i += 2; continue
        if a in ("-q", "--jq"):
            jq = argv[i + 1]; i += 2; continue
        if a in ("-H", "--header", "--hostname", "--cache", "-t", "--template"):
            i += 2; continue
        if a == "--input":
            inp = argv[i + 1]; i += 2; continue
        if a in ("--paginate", "--slurp", "--silent", "-i", "--include", "--verbose"):
            i += 1; continue
        if a.startswith("-"):
            die(f"gh stub: unsupported flag {a}")
        endpoint = a; i += 1
    if endpoint is None:
        die("gh stub: api needs an endpoint")
    body = parse_fields(fields)
    if inp:
        body.update(json.load(sys.stdin if inp == "-" else open(inp)))
    if method is None:
        method = "POST" if body else "GET"
    url = urlsplit(endpoint.lstrip("/"))
    path, q = url.path, {k: v[-1] for k, v in parse_qs(url.query).items()}
    st = Store()
    out = route(st, method, path, q, body)
    if out is None:
        return
    text = json.dumps(out)
    if jq:
        r = subprocess.run(["jq", "-r", jq], input=text, capture_output=True, text=True)
        sys.stdout.write(r.stdout)
        if r.returncode:
            die(r.stderr)
    else:
        sys.stdout.write(text + "\n")


def route(st, method, path, q, body):
    if path == "user":
        return {"login": LOGIN}
    m = re.fullmatch(r"search/issues", path)
    if m:
        return search(st, q.get("q", ""))
    m = re.fullmatch(r"repos/([^/]+)/([^/]+)(/.*)?", path)
    if not m:
        die(f"gh stub: unsupported endpoint {path}")
    owner, repo, rest = m.group(1), m.group(2), m.group(3) or ""
    if rest == "":
        return {"full_name": f"{owner}/{repo}", "private": True, "visibility": "private"}
    if rest == "/issues" and method == "GET":
        state = q.get("state", "open")
        want = [x for x in q.get("labels", "").split(",") if x]
        out = []
        for i in st.issues(owner, repo):
            if state != "all" and i["state"] != state:
                continue
            if any(w not in i["labels"] for w in want):
                continue
            out.append(public_issue(owner, repo, i))
        return sorted(out, key=lambda x: -x["number"])
    if rest == "/issues" and method == "POST":
        if not body.get("title"):
            die("gh: Validation Failed (HTTP 422)")
        n = st.next_id(f"{owner}__{repo}.issue_counter")
        i = {"number": n, "title": body["title"], "body": body.get("body", ""), "state": "open",
             "state_reason": None, "labels": list(dict.fromkeys(body.get("labels", []))),
             "created_at": now(), "updated_at": now(), "closed_at": None, "author": LOGIN, "comments": []}
        for lb in i["labels"]:
            ensure_label(st, owner, repo, lb)
        st.put(owner, repo, i)
        return public_issue(owner, repo, i)
    m = re.fullmatch(r"/issues/(\d+)", rest)
    if m:
        i = st.get(owner, repo, int(m.group(1)))
        if method == "GET":
            return public_issue(owner, repo, i)
        if method == "PATCH":
            for k in ("title", "body", "state", "state_reason"):
                if k in body:
                    i[k] = body[k]
            if "labels" in body:
                i["labels"] = list(body["labels"])
            i["closed_at"] = now() if i["state"] == "closed" else None
            i["updated_at"] = now()
            st.put(owner, repo, i)
            return public_issue(owner, repo, i)
    m = re.fullmatch(r"/issues/(\d+)/comments", rest)
    if m:
        i = st.get(owner, repo, int(m.group(1)))
        if method == "GET":
            return [public_comment(owner, repo, i, c) for c in i["comments"]]
        if method == "POST":
            c = {"id": st.next_id("comment_counter"), "body": body.get("body", ""),
                 "created_at": now(), "updated_at": now(), "author": LOGIN}
            i["comments"].append(c); i["updated_at"] = now()
            st.put(owner, repo, i)
            return public_comment(owner, repo, i, c)
    m = re.fullmatch(r"/issues/comments/(\d+)", rest)
    if m:
        i, c = st.find_comment(owner, repo, int(m.group(1)))
        if method == "GET":
            return public_comment(owner, repo, i, c)
        if method == "PATCH":
            c["body"] = body.get("body", c["body"]); c["updated_at"] = now()
            st.put(owner, repo, i)
            return public_comment(owner, repo, i, c)
        if method == "DELETE":
            i["comments"] = [x for x in i["comments"] if x["id"] != c["id"]]
            st.put(owner, repo, i)
            return None
    m = re.fullmatch(r"/issues/(\d+)/labels", rest)
    if m and method == "POST":
        i = st.get(owner, repo, int(m.group(1)))
        for lb in body.get("labels", []):
            if lb not in i["labels"]:
                i["labels"].append(lb)
            ensure_label(st, owner, repo, lb)
        st.put(owner, repo, i)
        return [{"name": n} for n in i["labels"]]
    m = re.fullmatch(r"/issues/(\d+)/labels/(.+)", rest)
    if m and method == "DELETE":
        i = st.get(owner, repo, int(m.group(1)))
        name = unquote(m.group(2))
        if name not in i["labels"]:
            die("gh: Label does not exist (HTTP 404)")
        i["labels"].remove(name)
        st.put(owner, repo, i)
        return [{"name": n} for n in i["labels"]]
    if rest == "/labels" and method == "GET":
        return st.labels(owner, repo)
    if rest == "/labels" and method == "POST":
        ensure_label(st, owner, repo, body["name"], body.get("color", "ededed"), body.get("description", ""))
        return {"name": body["name"]}
    if rest == "/pulls" and method == "GET":
        p = os.path.join(D, f"{owner}__{repo}", "pulls.json")
        return json.load(open(p)) if os.path.exists(p) else []
    die(f"gh stub: unsupported route {method} {path}")


def ensure_label(st, owner, repo, name, color="ededed", desc=""):
    labels = st.labels(owner, repo)
    for lb in labels:
        if lb["name"] == name:
            lb["color"], lb["description"] = color or lb["color"], desc or lb.get("description", "")
            break
    else:
        labels.append({"name": name, "color": color, "description": desc})
    st.set_labels(owner, repo, labels)


def search(st, query):
    terms = query.split()
    repos, labels, state, kind = [], [], None, None
    for t in terms:
        if t.startswith("repo:"):
            repos.append(t[5:])
        elif t.startswith("label:"):
            labels.append(t[6:].strip('"'))
        elif t in ("is:open", "state:open"):
            state = "open"
        elif t in ("is:closed", "state:closed"):
            state = "closed"
        elif t == "is:issue":
            kind = "issue"
    items = []
    for full in repos:
        owner, repo = full.split("/", 1)
        for i in st.issues(owner, repo):
            if state and i["state"] != state:
                continue
            if any(lb not in i["labels"] for lb in labels):
                continue
            items.append(public_issue(owner, repo, i))
    return {"total_count": len(items), "items": items}


def label_create(argv):
    name, repo, color, desc = argv[0], os.environ.get("GH_REPO"), "ededed", ""
    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("-R", "--repo"):
            repo = argv[i + 1]; i += 2
        elif a in ("-c", "--color"):
            color = argv[i + 1]; i += 2
        elif a in ("-d", "--description"):
            desc = argv[i + 1]; i += 2
        else:
            i += 1
    if not repo:
        die("gh stub: label create needs --repo")
    owner, r = repo.split("/", 1)
    ensure_label(Store(), owner, r, name, color, desc)


ISSUE_FIELDS = ("number", "title", "state", "body", "labels", "url", "createdAt", "updatedAt",
                "closedAt", "comments", "author", "stateReason")


def gh_issue_json(owner, repo, i):
    return {
        "number": i["number"], "title": i["title"], "state": i["state"].upper(), "body": i["body"],
        "labels": [{"name": n} for n in i["labels"]],
        "url": f"https://github.com/{owner}/{repo}/issues/{i['number']}",
        "createdAt": i["created_at"], "updatedAt": i["updated_at"], "closedAt": i["closed_at"],
        "comments": [{"body": c["body"], "author": {"login": c.get("author", LOGIN)}, "createdAt": c["created_at"]}
                     for c in i["comments"]],
        "author": {"login": i.get("author", LOGIN)},
        "stateReason": (i.get("state_reason") or "").upper(),
    }


def emit_json(data, fields, jq):
    fl = [f for f in fields.split(",") if f]
    for f in fl:
        if f not in ISSUE_FIELDS:
            die(f"Unknown JSON field: \"{f}\"")
    pick = lambda o: {f: o[f] for f in fl}
    out = [pick(o) for o in data] if isinstance(data, list) else pick(data)
    text = json.dumps(out)
    if jq:
        r = subprocess.run(["jq", "-r", jq], input=text, capture_output=True, text=True)
        sys.stdout.write(r.stdout)
        if r.returncode:
            die(r.stderr)
    else:
        sys.stdout.write(json.dumps(out, indent=2) + "\n")


def split_list(vals):
    return [x.strip() for v in vals for x in v.split(",") if x.strip()]


def parse_opts(argv, spec):
    """spec: {flag: (key, kind)} kind in 'val','multi','bool'. Returns (opts, positionals)."""
    opts, pos, i = {}, [], 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("-") and a != "-":
            name, eq, inline = a.partition("=")
            if name not in spec:
                die(f"gh stub: unsupported flag {name}")
            key, kind = spec[name]
            if kind == "bool":
                opts[key] = True; i += 1; continue
            if eq:
                v = inline; i += 1
            else:
                if i + 1 >= len(argv):
                    die(f"flag needs an argument: {name}")
                v = argv[i + 1]; i += 2
            if kind == "multi":
                opts.setdefault(key, []).append(v)
            else:
                opts[key] = v
            continue
        pos.append(a); i += 1
    return opts, pos


REPO_FLAGS = {"-R": ("repo", "val"), "--repo": ("repo", "val")}
JSON_FLAGS = {"--json": ("json", "val"), "-q": ("jq", "val"), "--jq": ("jq", "val"),
              "-t": ("template", "val"), "--template": ("template", "val")}


def home_repo():
    """The repo= key of the nearest home.config above the cwd (stands in for the git remote real gh reads)."""
    d = os.getcwd()
    while True:
        f = os.path.join(d, "home.config")
        if os.path.isfile(f):
            for line in open(f):
                m = re.match(r"\s*repo\s*=\s*(\S+/\S+)\s*$", line)
                if m:
                    return m.group(1)
            return None
        if os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


def resolve_repo(opts):
    r = opts.get("repo") or os.environ.get("GH_REPO") or home_repo()
    if not r or "/" not in r:
        die("gh stub: no repository: pass --repo OWNER/REPO")
    owner, repo = r.split("/", 1)
    return owner, repo


def read_body(opts, key="body", fkey="body_file"):
    if fkey in opts:
        f = opts[fkey]
        return sys.stdin.read() if f == "-" else open(f).read()
    return opts.get(key)


def issue_number(pos, opts):
    if len(pos) != 1:
        die("gh stub: expected one issue number or URL")
    a = pos[0]
    m = re.fullmatch(r"https://github\.com/([^/]+)/([^/]+)/issues/(\d+)/?", a)
    if m:
        return m.group(1), m.group(2), int(m.group(3))
    m = re.fullmatch(r"#?(\d+)", a)
    if not m:
        die(f"invalid issue format: \"{a}\"")
    owner, repo = resolve_repo(opts)
    return owner, repo, int(m.group(1))


def touch(st, owner, repo, i):
    i["updated_at"] = now(); st.put(owner, repo, i)


def add_comment(st, owner, repo, i, body):
    c = {"id": st.next_id("comment_counter"), "body": body, "created_at": now(), "updated_at": now(), "author": LOGIN}
    i["comments"].append(c); touch(st, owner, repo, i)
    return public_comment(owner, repo, i, c)


def issue_url(owner, repo, n):
    return f"https://github.com/{owner}/{repo}/issues/{n}"


def issue_create(argv):
    spec = {**REPO_FLAGS, "-t": ("title", "val"), "--title": ("title", "val"), "-b": ("body", "val"),
            "--body": ("body", "val"), "-F": ("body_file", "val"), "--body-file": ("body_file", "val"),
            "-l": ("label", "multi"), "--label": ("label", "multi"), "-a": ("x", "multi"),
            "--assignee": ("x", "multi"), "-m": ("x", "multi"), "--milestone": ("x", "multi"),
            "-p": ("x", "multi"), "--project": ("x", "multi")}
    opts, pos = parse_opts(argv, spec)
    if pos:
        die(f"gh stub: unexpected argument {pos[0]}")
    owner, repo = resolve_repo(opts)
    if not opts.get("title"):
        die("must provide `--title` and `--body` (or `--body-file`) when not running interactively")
    body = read_body(opts)
    if body is None:
        die("must provide `--title` and `--body` (or `--body-file`) when not running interactively")
    out = route(Store(), "POST", f"repos/{owner}/{repo}/issues", {},
                {"title": opts["title"], "body": body, "labels": split_list(opts.get("label", []))})
    sys.stdout.write(out["html_url"] + "\n")


def issue_list(argv):
    spec = {**REPO_FLAGS, **JSON_FLAGS, "-s": ("state", "val"), "--state": ("state", "val"),
            "-l": ("label", "multi"), "--label": ("label", "multi"), "-L": ("limit", "val"),
            "--limit": ("limit", "val"), "-S": ("search", "val"), "--search": ("search", "val")}
    opts, pos = parse_opts(argv, spec)
    if pos:
        die(f"gh stub: unexpected argument {pos[0]}")
    owner, repo = resolve_repo(opts)
    state = opts.get("state", "open")
    if state not in ("open", "closed", "all"):
        die(f"invalid argument \"{state}\" for \"--state\" flag")
    want = split_list(opts.get("label", []))
    try:
        limit = int(opts.get("limit", 30))
    except ValueError:
        die(f"invalid argument \"{opts['limit']}\" for \"--limit\" flag")
    if limit < 1:
        die(f"invalid limit: {limit}")
    needle = opts.get("search", "").lower()
    rows = []
    for i in sorted(Store().issues(owner, repo), key=lambda x: -x["number"]):
        if state != "all" and i["state"] != state:
            continue
        if any(w not in i["labels"] for w in want):
            continue
        if needle and needle not in (i["title"] + "\n" + (i["body"] or "")).lower():
            continue
        rows.append(i)
    rows = rows[:limit]
    if "json" in opts:
        return emit_json([gh_issue_json(owner, repo, i) for i in rows], opts["json"], opts.get("jq"))
    if "jq" in opts:
        die("cannot use `--jq` without specifying `--json`")
    for i in rows:
        sys.stdout.write(f"{i['number']}\t{i['state'].upper()}\t{i['title']}\t{', '.join(i['labels'])}\t{i['updated_at']}\n")


def issue_view(argv):
    spec = {**REPO_FLAGS, **JSON_FLAGS, "-c": ("comments", "bool"), "--comments": ("comments", "bool")}
    opts, pos = parse_opts(argv, spec)
    owner, repo, n = issue_number(pos, opts)
    i = Store().get(owner, repo, n)
    if "json" in opts:
        return emit_json(gh_issue_json(owner, repo, i), opts["json"], opts.get("jq"))
    if "jq" in opts:
        die("cannot use `--jq` without specifying `--json`")
    if opts.get("comments"):
        for c in i["comments"]:
            sys.stdout.write(f"author:\t{c.get('author', LOGIN)}\nassociation:\towner\nedited:\tfalse\n--\n{c['body']}\n--\n")
        return
    sys.stdout.write(f"title:\t{i['title']}\nstate:\t{i['state'].upper()}\nauthor:\t{i.get('author', LOGIN)}\n"
                     f"labels:\t{', '.join(i['labels'])}\ncomments:\t{len(i['comments'])}\n"
                     f"number:\t{i['number']}\n--\n{i['body']}\n")


def issue_comment(argv):
    spec = {**REPO_FLAGS, "-b": ("body", "val"), "--body": ("body", "val"), "-F": ("body_file", "val"),
            "--body-file": ("body_file", "val"), "--edit-last": ("edit_last", "bool")}
    opts, pos = parse_opts(argv, spec)
    owner, repo, n = issue_number(pos, opts)
    body = read_body(opts)
    if body is None:
        die("`--body` or `--body-file` required when not running interactively")
    st = Store()
    i = st.get(owner, repo, n)
    if opts.get("edit_last"):
        mine = [c for c in i["comments"] if c.get("author", LOGIN) == LOGIN]
        if not mine:
            die("no comments found for current user")
        c = mine[-1]; c["body"] = body; c["updated_at"] = now()
        touch(st, owner, repo, i)
        out = public_comment(owner, repo, i, c)
    else:
        out = add_comment(st, owner, repo, i, body)
    sys.stdout.write(out["html_url"] + "\n")


def issue_close(argv, reopen=False):
    spec = {**REPO_FLAGS, "-c": ("comment", "val"), "--comment": ("comment", "val")}
    if not reopen:
        spec.update({"-r": ("reason", "val"), "--reason": ("reason", "val")})
    opts, pos = parse_opts(argv, spec)
    owner, repo, n = issue_number(pos, opts)
    reason = opts.get("reason", "completed")
    reasons = {"completed": "completed", "not planned": "not_planned", "not_planned": "not_planned"}
    if reason not in reasons:
        die(f"invalid argument \"{reason}\" for \"-r, --reason\" flag")
    st = Store()
    i = st.get(owner, repo, n)
    want = "open" if reopen else "closed"
    if i["state"] == want:
        sys.stderr.write(f"! Issue {owner}/{repo}#{n} ({i['title']}) is already {want}\n"); return
    if opts.get("comment"):
        add_comment(st, owner, repo, i, opts["comment"])
    i["state"] = want
    i["state_reason"] = "reopened" if reopen else reasons[reason]
    i["closed_at"] = None if reopen else now()
    touch(st, owner, repo, i)
    sys.stderr.write(f"✓ {'Reopened' if reopen else 'Closed'} issue {owner}/{repo}#{n} ({i['title']})\n")


def issue_edit(argv):
    spec = {**REPO_FLAGS, "-t": ("title", "val"), "--title": ("title", "val"), "-b": ("body", "val"),
            "--body": ("body", "val"), "-F": ("body_file", "val"), "--body-file": ("body_file", "val"),
            "--add-label": ("add", "multi"), "--remove-label": ("remove", "multi")}
    opts, pos = parse_opts(argv, spec)
    owner, repo, n = issue_number(pos, opts)
    st = Store()
    i = st.get(owner, repo, n)
    if "title" in opts:
        i["title"] = opts["title"]
    body = read_body(opts)
    if body is not None:
        i["body"] = body
    for lb in split_list(opts.get("add", [])):
        if lb not in i["labels"]:
            i["labels"].append(lb)
        ensure_label(st, owner, repo, lb)
    for lb in split_list(opts.get("remove", [])):
        if lb in i["labels"]:
            i["labels"].remove(lb)
    touch(st, owner, repo, i)
    sys.stdout.write(issue_url(owner, repo, n) + "\n")


ISSUE_VERBS = {"create": issue_create, "list": issue_list, "view": issue_view, "comment": issue_comment,
               "close": issue_close, "reopen": lambda a: issue_close(a, reopen=True), "edit": issue_edit}


def main():
    argv = sys.argv[1:]
    fail = os.environ.get("GH_STUB_FAIL_MATCH")
    if fail and re.search(fail, " ".join(argv)):
        log(argv, "injected-failure")
        die(os.environ.get("GH_STUB_FAIL_MESSAGE", "gh: Server Error (HTTP 502)"))
    log(argv, "ok")
    if argv[:1] == ["api"]:
        return api(argv[1:])
    if argv[:1] == ["issue"] and len(argv) > 1 and argv[1] in ISSUE_VERBS:
        return ISSUE_VERBS[argv[1]](argv[2:])
    if argv[:2] == ["label", "create"]:
        return label_create(argv[2:])
    if argv[:2] == ["auth", "status"]:
        sys.stdout.write(f"Logged in to github.com account {LOGIN} (stub)\n"); return
    if argv[:2] == ["auth", "switch"]:
        die("gh stub: refused")
    die(f"gh stub: unsupported command: {' '.join(argv[:3])}")


main()
