#!/usr/bin/env bash
# configure: makes this repo the owner's own home from flat answers.
#   scripts/configure --answers <file> [--labels]
# The configure skill asks the questions, writes the answers to .local/answers and
# calls this script; an unattended run writes the file itself. Same code path.
# templates/answers.example documents every key.
#
# Writes (and only these): home.config (committed keys), .local/config (machine
# keys; other lines there are kept), the home section of CLAUDE.md (below the
# BUFFER lines; the base block is never touched), .claude/settings.json
# (enabledPlugins from the answers), .gitignore (missing template lines added),
# the terminal_helpers line of the answers file (when the device check turns it off),
# wiki/index.md and DECISIONS.md (only when absent), wiki/howto/accounts.md
# (when accounts.multi=yes) and deletes the base-only paths of base.manifest that
# are still tracked. Only then the git steps: core.hooksPath, the base-only paths
# dropped from the index, and the remotes: when origin is the base (base.url) it
# becomes base (push disabled) and origin becomes the repo of the answers.
# Before writing anything it probes whether this session may change the git
# settings; when it may not, it does every other step, prints one line
# "pending: cd <root> && <the git steps still needed>" for the person's own
# terminal and still exits 0. It never pushes. --labels then runs scripts/labels.
# Exit: 0 ok (check for a "pending:" line), 2 missing or invalid answers (nothing
# written), 3 repo not ready or a write or git step failed (the file or step is
# named), 4 files written but --labels failed (the last line says whether the repo
# was not found or this login may not manage labels, and ends with the one line,
# starting "cd <root> &&", that does the rest from the person's own terminal: any
# pending git steps with the upload, then the labels), 5 files written but git
# refused a step after the probe allowed it (the last line gives the full rerun line).
# Running it twice with the same answers gives the same files.
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
HOME_ROOT=$ROOT; export HOME_ROOT
T="$ROOT/templates"

die() { local c=$1; shift; echo "configure: $*" >&2; exit "$c"; }
ANS=""; LABELS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --answers) [ $# -ge 2 ] || die 2 "--answers needs a file"; ANS=$2; shift 2 ;;
    --labels) LABELS=1; shift ;;
    -h|--help) sed -n '2,27p' "$0"; exit 0 ;;
    *) die 2 "unknown option '$1' (usage: configure --answers <file> [--labels])" ;;
  esac
done
[ -n "$ANS" ] || die 2 "usage: configure --answers <file> [--labels]"
[ -f "$ANS" ] || die 2 "answers file not found: $ANS"
command -v jq >/dev/null 2>&1 || die 3 "jq is required"

# ---------- reading answers (no '~' expansion: values are written as given) ----------
ans_all() { # every value of a key, in order
  awk -v k="$1" '
    /^[[:space:]]*#/ { next }
    { i = index($0, "="); if (i == 0) next
      key = substr($0, 1, i - 1); val = substr($0, i + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      if (key == k) print val }' "$ANS"
}
ans() { ans_all "$1" | tail -1; }
ans_keys() { awk '/^[[:space:]]*#/ { next } { i = index($0, "="); if (i == 0) next
  key = substr($0, 1, i - 1); gsub(/^[[:space:]]+|[[:space:]]+$/, "", key); if (key != "") print key }' "$ANS" | sort -u; }
ans_has() { ans_keys | grep -qxF -- "$1"; }

# ---------- key tables ----------
REQUIRED="repo owner.names home.domain home.boundary lang.files lang.owner tracker.board labels.needs_owner limits.mode proactivity.mode dreams.mode accounts.multi terminal_helpers"
PRESENT="plugins"
REPEATABLE="home.rules guard.extra accounts.rows"
# committed keys and their defaults (order = order in home.config)
COMMITTED_DEFAULTS="repo=
lang.files=en
lang.owner=en
tracker.backend=github
tracker.board=none
tracker.board_write=
labels.needs_owner=needs-owner
base.url=
limits.mode=none
limits.threshold=90
proactivity.mode=assigned
proactivity.sources=
proactivity.every_minutes=60
dreams.mode=manual
dreams.first_window_days=14
facts.sink=none
sweep.stale_hours=6
sweep.lookback_days=14"
MACHINE_DEFAULTS="gh.config_dir=
terminal_helpers=off
transcripts.paths=~/.claude/projects,~/.codex/sessions
transcripts.exclude=
limits.reader=none
launch.profile.orchestrator=
launch.profile.worker=
launch.model=
launch.command=claude
launch.profile_flag=
guard.private_values=
guard.boundary_terms="
HOME_FIELDS="owner.names home.domain home.boundary plugins accounts.multi"

val() { # val <key>: the answer when non-empty, else the default
  local d v
  v=$(ans "$1")
  if [ -z "$v" ]; then
    d=$(printf '%s\n%s\n' "$COMMITTED_DEFAULTS" "$MACHINE_DEFAULTS" | awk -v k="$1" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }')
    v=$d
  fi
  printf '%s' "$v"
}
src() { [ -n "$(ans "$1")" ] && echo answer || echo default; }

# ---------- validation: collect every problem, write nothing on any ----------
MISSING=(); BAD=()
for k in $REQUIRED; do [ -n "$(ans "$k")" ] || MISSING+=("$k"); done
for k in $PRESENT; do ans_has "$k" || MISSING+=("$k"); done
BOARD=$(val tracker.board)
[ "$BOARD" != none ] && [ -z "$(ans tracker.board_write)" ] && MISSING+=("tracker.board_write")
MULTI=$(ans accounts.multi)
[ "$MULTI" = yes ] && [ -z "$(ans_all accounts.rows | grep -v '^$')" ] && MISSING+=("accounts.rows")

enum() { # enum <key> <allowed...>
  local k=$1 v a; shift; v=$(ans "$k"); [ -n "$v" ] || return 0
  for a in "$@"; do [ "$v" = "$a" ] && return 0; done
  BAD+=("$k=$v (allowed: $*)")
}
num() { local v; v=$(ans "$1"); [ -n "$v" ] || return 0
  case "$v" in *[!0-9]*) BAD+=("$1=$v (a whole number)") ;; esac; }
enum tracker.backend github
enum tracker.board_write ask-first yes read-only
enum limits.mode none soft hard
enum proactivity.mode assigned off watch
enum dreams.mode manual daily
enum accounts.multi yes no
enum terminal_helpers on off
for k in limits.threshold proactivity.every_minutes dreams.first_window_days sweep.stale_hours sweep.lookback_days; do num "$k"; done
v=$(ans repo); [ -z "$v" ] || printf '%s' "$v" | grep -qE '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || BAD+=("repo=$v (owner/name)")
url_key() { # a remote URL reduced to host/owner/name, for comparing
  printf '%s' "$1" | tr 'A-Z' 'a-z' | sed -e 's#^git@\([^:]*\):#https://\1/#' -e 's#^[a-z+]*://##' -e 's#^[^@/]*@##' -e 's#/*$##' -e 's#\.git$##'; }
[ -n "$(ans repo)" ] && [ -n "$(ans base.url)" ] && [ "$(url_key "https://github.com/$(ans repo)")" = "$(url_key "$(ans base.url)")" ] \
  && BAD+=("repo=$(ans repo) (this is the base itself; name the repo of your own home)")
for k in lang.files lang.owner; do
  v=$(ans "$k"); [ -z "$v" ] || printf '%s' "$v" | grep -qE '^[a-z]{2}(-[A-Za-z0-9]+)?$' || BAD+=("$k=$v (a two-letter language code such as en or es)")
done
case "$(ans tracker.board)" in *[!a-z0-9-]*) BAD+=("tracker.board=$(ans tracker.board) (none or a lower-case board name)") ;; esac
case "$(ans launch.command)" in *[!A-Za-z0-9._-]*) BAD+=("launch.command=$(ans launch.command) (one command word, such as claude or codex)") ;; esac
case "$(ans labels.needs_owner)" in *[!A-Za-z0-9:_-]*) BAD+=("labels.needs_owner=$(ans labels.needs_owner) (letters, digits, : _ -)") ;; esac

# accounts rows: three fields, labels only
ROWS=()
if [ "$MULTI" = yes ]; then
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    case "$r" in *@*) BAD+=("accounts.rows: '$r' holds an address; write a label only"); continue ;; esac
    n=$(printf '%s' "$r" | awk -F'|' '{ print NF }')
    [ "$n" = 3 ] || { BAD+=("accounts.rows: '$r' (label | what it serves | where the mapping lives)"); continue; }
    ROWS+=("$r")
  done < <(ans_all accounts.rows)
fi

# related homes
HOMES=$(ans_keys | sed -n 's/^homes\.\([A-Za-z0-9_-]*\)\.[a-z]*$/\1/p' | sort -u)
for h in $HOMES; do
  [ -n "$(ans "homes.$h.repo")" ] || MISSING+=("homes.$h.repo")
  r=$(ans "homes.$h.role")
  case "$r" in parent|child|peer) ;; '') MISSING+=("homes.$h.role") ;; *) BAD+=("homes.$h.role=$r (parent, child or peer)") ;; esac
done
for k in $(ans_keys); do
  case "$k" in homes.*.repo|homes.*.path|homes.*.role) continue ;; esac
  case " $REQUIRED $PRESENT $REPEATABLE $HOME_FIELDS " in *" $k "*) continue ;; esac
  printf '%s\n%s\n' "$COMMITTED_DEFAULTS" "$MACHINE_DEFAULTS" | grep -q "^$k=" && continue
  echo "configure: warning: unknown key '$k' ignored" >&2
done

if [ ${#MISSING[@]} -gt 0 ] || [ ${#BAD[@]} -gt 0 ]; then
  for k in ${MISSING[@]+"${MISSING[@]}"}; do echo "configure: missing answer: $k" >&2; done
  for k in ${BAD[@]+"${BAD[@]}"}; do echo "configure: invalid answer: $k" >&2; done
  echo "configure: nothing written; see templates/answers.example" >&2
  exit 2
fi

# repo must already hold the base files
for f in home.config settings.json gitignore CLAUDE.home-section.md wiki/index.md wiki/howto/accounts.md DECISIONS.md; do
  [ -f "$T/$f" ] || die 3 "template missing: templates/$f"
done
BUF4='<!-- BUFFER 4/4: the home section starts on the next line. -->'
[ -f "$ROOT/CLAUDE.md" ] && grep -qxF "$BUF4" "$ROOT/CLAUDE.md" \
  || die 3 "CLAUDE.md with the base block and the four BUFFER lines is required; take it from the base first"

# ---------- may this session change the git settings? (probe before any write) ----------
IS_GIT=0; [ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" = "$ROOT" ] && IS_GIT=1
GIT_OK=1
if [ "$IS_GIT" = 1 ]; then
  { git -C "$ROOT" config --local configure.probe 1 && git -C "$ROOT" config --local --unset configure.probe; } >/dev/null 2>&1 || GIT_OK=0
fi

# ---------- terminal helpers: on only after the device check ----------
HELPERS=$(ans terminal_helpers)
HELPERS_NOTE=""
device_ok() {
  [ "$(uname -s)" = Darwin ] || return 1
  command -v osascript >/dev/null 2>&1 || return 1
  [ "$(osascript -e 'return "ok"' 2>/dev/null)" = ok ] || return 1
  osascript -e 'id of application "iTerm"' >/dev/null 2>&1   # resolves the app without launching it
}
if [ "$HELPERS" = on ] && ! device_ok; then
  HELPERS=off; HELPERS_NOTE=" (asked on; device check failed: needs macOS, osascript and iTerm2)"
fi
if [ "$(ans terminal_helpers)" != "$HELPERS" ]; then # the answers file keeps the value actually written
  awk -v v="$HELPERS" '{ i = index($0, "="); k = substr($0, 1, i - 1); gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)
    if (i > 0 && $0 !~ /^[[:space:]]*#/ && k == "terminal_helpers") print "terminal_helpers=" v; else print }' "$ANS" > "$ANS.tmp" 2>/dev/null \
    && mv "$ANS.tmp" "$ANS" 2>/dev/null || { rm -f "$ANS.tmp"; die 3 "cannot write $ANS; nothing else is written, fix it and run configure again"; }
  echo "configure: wrote $ANS (terminal_helpers=$HELPERS)"
fi

# ---------- writers ----------
put() { # put <relative path> <content>; writes only when it changes
  local p="$ROOT/$1"
  if [ -f "$p" ] && [ "$(cat "$p")" = "$2" ]; then return 0; fi
  mkdir -p "$(dirname "$p")" 2>/dev/null && [ ! -d "$p" ] && printf '%s\n' "$2" 2>/dev/null > "$p" \
    || die 3 "cannot write $1; files before it may be written, fix it and run configure again"
  echo "configure: wrote $1"
}
subst() { # subst <template file>: replaces {{NAME}} with $S_NAME, literally
  awk '{
    line = $0; out = ""
    while ((i = index(line, "{{")) > 0) {
      j = index(substr(line, i + 2), "}}")
      if (j == 0) break
      name = substr(line, i + 2, j - 1)
      out = out substr(line, 1, i - 1) ENVIRON["S_" name]
      line = substr(line, i + 2 + j + 1)
    }
    print out line
  }' "$1"
}

# home.config, from the template with the answers filled in
GUARD_LINES=$(ans_all guard.extra | grep -v '^$' | sed 's/^/guard.extra=/')
HOMES_LINES=""
for h in $HOMES; do
  for f in repo path role; do
    v=$(ans "homes.$h.$f"); [ -n "$v" ] && HOMES_LINES="$HOMES_LINES"$'\n'"homes.$h.$f=$v"
  done
done
HOMES_LINES=${HOMES_LINES#$'\n'}
VALUES=""
while IFS= read -r line; do
  k=${line%%=*}; v=$(val "$k")
  [ "$k" = tracker.board_write ] && [ "$BOARD" = none ] && v=""   # written only when a board is named
  VALUES="$VALUES$k"$'\t'"$v"$'\n'
done <<EOF
$COMMITTED_DEFAULTS
EOF
HC=$(V_VALUES=$VALUES V_GUARD=$GUARD_LINES V_HOMES=$HOMES_LINES awk '
  BEGIN { n = split(ENVIRON["V_VALUES"], a, "\n")
          for (i = 1; i <= n; i++) { t = index(a[i], "\t"); if (t) v[substr(a[i], 1, t - 1)] = substr(a[i], t + 1) } }
  /^#@guard\.extra$/ { if (ENVIRON["V_GUARD"] != "") print ENVIRON["V_GUARD"]; next }
  /^#@homes$/ { if (ENVIRON["V_HOMES"] != "") print ENVIRON["V_HOMES"]; next }
  /^[a-z][a-z._]*=/ { k = substr($0, 1, index($0, "=") - 1); if (k in v) { print k "=" v[k]; next } }
  { print }' "$T/home.config")
put home.config "$HC"

# .local/config: managed machine keys; any other line there is kept
LC_OLD=""; [ -f "$ROOT/.local/config" ] && LC_OLD=$(cat "$ROOT/.local/config")
MANAGED=$(printf '%s\n' "$MACHINE_DEFAULTS" | cut -d= -f1)
KEPT=$(printf '%s\n' "$LC_OLD" | V_M="$MANAGED" awk '
  BEGIN { n = split(ENVIRON["V_M"], a, "\n"); for (i = 1; i <= n; i++) m[a[i]] = 1 }
  /^[[:space:]]*#/ || !/=/ { next }
  { k = substr($0, 1, index($0, "=") - 1); gsub(/^[[:space:]]+|[[:space:]]+$/, "", k); if (!(k in m)) print }')
LC="# .local/config: this machine only (gitignored). Overrides home.config.
# Machine keys below are written by scripts/configure; other key lines are kept."
[ -n "$KEPT" ] && LC="$LC"$'\n'"$KEPT"
for k in $MANAGED; do
  if [ "$k" = terminal_helpers ]; then v=$HELPERS; else v=$(val "$k"); fi
  [ -n "$v" ] && LC="$LC"$'\n'"$k=$v"
done
put .local/config "$LC"

# CLAUDE.md: base block and buffer untouched, home section replaced
RULES=$(ans_all home.rules | grep -v '^$' | sed 's/^/- /')
[ -n "$RULES" ] || RULES="- (none yet)"
SECTION=$(S_OWNER_NAMES=$(ans owner.names) S_HOME_DOMAIN=$(ans home.domain) S_HOME_BOUNDARY=$(ans home.boundary) \
  S_HOME_RULES=$RULES subst "$T/CLAUDE.home-section.md")
HEAD=$(awk -v b="$BUF4" '{ print } $0 == b { exit }' "$ROOT/CLAUDE.md")
put CLAUDE.md "$HEAD"$'\n'"$SECTION"

# .claude/settings.json: template (or the existing file) with enabledPlugins from the answers
SBASE="$T/settings.json"; [ -f "$ROOT/.claude/settings.json" ] && SBASE="$ROOT/.claude/settings.json"
ST=$(jq --arg p "$(ans plugins)" '
  ($p | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))) as $l
  | if ($l | length) > 0 then .enabledPlugins = ($l | map({(.): true}) | add) else del(.enabledPlugins) end' "$SBASE") \
  || die 3 "cannot read $SBASE as JSON"
put .claude/settings.json "$ST"

# .gitignore: the template lines, added when missing
GI=""; [ -f "$ROOT/.gitignore" ] && GI=$(cat "$ROOT/.gitignore")
while IFS= read -r l; do
  [ -n "$l" ] || continue
  printf '%s\n' "$GI" | grep -qxF "$l" || GI="${GI:+$GI$'\n'}$l"
done < "$T/gitignore"
put .gitignore "$GI"

# wiki/index.md and DECISIONS.md: created once, never overwritten
[ -f "$ROOT/wiki/index.md" ] || put wiki/index.md "$(S_HOME_DOMAIN=$(ans home.domain) subst "$T/wiki/index.md")"
[ -f "$ROOT/DECISIONS.md" ] || put DECISIONS.md "$(cat "$T/DECISIONS.md")"

# wiki/howto/accounts.md: labels only
if [ "$MULTI" = yes ]; then
  AR=""
  for r in "${ROWS[@]}"; do
    AR="${AR:+$AR$'\n'}| $(printf '%s' "$r" | awk -F'|' '{ for (i = 1; i <= 3; i++) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i) } print $1 " | " $2 " | " $3 }') |"
  done
  put wiki/howto/accounts.md "$(S_ACCOUNT_ROWS=$AR subst "$T/wiki/howto/accounts.md")"
fi

# base-only paths: present in the base repo only, deleted from the home's folder
# here; the git phase below drops them from the index
BASE_ONLY=()
if [ "$IS_GIT" = 1 ] && [ -f "$ROOT/base.manifest" ]; then
  while read -r kind path _; do
    [ "$kind" = base-only ] || continue
    FILES=$(git -C "$ROOT" ls-files -- "$path")
    [ -n "$FILES" ] || continue
    BASE_ONLY+=("$path"); gone=0
    while IFS= read -r f; do
      [ -e "$ROOT/$f" ] || [ -L "$ROOT/$f" ] || continue
      rm -f "$ROOT/$f" 2>/dev/null || die 3 "cannot remove $f; files before it may be written, fix it and run configure again"
      (cd "$ROOT" && rmdir -p "$(dirname "$f")" 2>/dev/null); gone=1
    done <<<"$FILES"
    [ "$gone" = 1 ] && echo "configure: removed base-only path $path"
  done < "$ROOT/base.manifest"
fi

# git: hooks path, base-only paths out of the index, remotes (repo-local only; never pushes).
# Without git permission (the probe above) each step is collected for the pending line instead.
q() { printf '%q' "$1"; }
RERUN="cd $(q "$ROOT") && scripts/configure --answers $(q "$ANS")"
GITC() { # a git step; a refused permission exits 5, any other failure exits 3
  local err
  err=$(git -C "$ROOT" "$@" 2>&1 >/dev/null) && return 0
  case "$err" in
    *"Operation not permitted"*|*"could not lock config file"*|*"Permission denied"*|*[Rr]ead-only*)
      die 5 "the files are written, but git refused to change this repository's settings; run this line from your own terminal: $RERUN" ;;
  esac
  die 3 "git $* failed: $(printf '%s\n' "$err" | grep -v '^[[:space:]]*$' | head -1); the files are written, fix it and run configure again"
}
PEND_RM=(); PEND=()
step() { # step <git args...>: run it, or keep it for the pending line
  if [ "$GIT_OK" = 1 ]; then GITC "$@"; return; fi
  local c="git" a; for a in "$@"; do c="$c $(q "$a")"; done
  PEND+=("$c")
}
if [ "$IS_GIT" = 1 ]; then
  if [ ${#BASE_ONLY[@]} -gt 0 ]; then
    if [ "$GIT_OK" = 1 ]; then GITC rm -r -q --cached --ignore-unmatch -- "${BASE_ONLY[@]}"
    else c="git rm -rq --cached --ignore-unmatch --"; for p in "${BASE_ONLY[@]}"; do c="$c $(q "$p")"; done; PEND_RM=("$c"); fi
  fi
  # remotes: origin is the owner's repo, base is the base with push disabled
  BURL=$(ans base.url); RURL="https://github.com/$(ans repo).git"
  OURL=$(git -C "$ROOT" remote get-url origin 2>/dev/null)
  HAS_BASE=0; git -C "$ROOT" remote get-url base >/dev/null 2>&1 && HAS_BASE=1
  if [ -n "$BURL" ] && [ -n "$OURL" ] && [ "$(url_key "$OURL")" = "$(url_key "$BURL")" ]; then
    if [ "$HAS_BASE" = 1 ]; then
      step remote set-url origin "$RURL"
      [ -n "$(git -C "$ROOT" config --get-all remote.origin.pushurl 2>/dev/null)" ] && step config --unset-all remote.origin.pushurl
    else
      step remote rename origin base; HAS_BASE=1; [ "$GIT_OK" = 1 ] && echo "configure: renamed remote origin to base"
      step remote add origin "$RURL"
    fi
    [ "$GIT_OK" = 1 ] && echo "configure: origin now points to $(ans repo)"
  elif [ -z "$OURL" ]; then
    step remote add origin "$RURL"; [ "$GIT_OK" = 1 ] && echo "configure: added remote origin ($(ans repo))"
  fi
  if [ -n "$BURL" ]; then
    if [ "$HAS_BASE" = 0 ]; then
      step remote add base "$BURL"; [ "$GIT_OK" = 1 ] && echo "configure: added remote base"
    elif [ "$GIT_OK" = 1 ] && [ "$(git -C "$ROOT" remote get-url base)" != "$BURL" ]; then
      GITC remote set-url base "$BURL"; echo "configure: updated remote base"
    fi
    [ "$(git -C "$ROOT" remote get-url --push base 2>/dev/null)" = DISABLED ] || step remote set-url --push base DISABLED
  fi
  if [ "$(git -C "$ROOT" config --local core.hooksPath 2>/dev/null)" != .githooks ]; then
    step config core.hooksPath .githooks; [ "$GIT_OK" = 1 ] && echo "configure: set core.hooksPath=.githooks"
  fi
else
  echo "configure: warning: $ROOT is not a git repo root; hooks path, base-only paths and remotes not set" >&2
fi
PSTEPS=""
if [ ${#PEND_RM[@]} -gt 0 ] || [ ${#PEND[@]} -gt 0 ]; then
  rest=""; for c in ${PEND[@]+"${PEND[@]}"}; do rest="${rest:+$rest && }$c"; done
  PSTEPS="${PEND_RM[0]:-}"
  [ ${#PEND_RM[@]} -gt 0 ] && [ -n "$rest" ] && PSTEPS="$PSTEPS ; "
  PSTEPS="$PSTEPS$rest"
fi
PENDING=""; [ -n "$PSTEPS" ] && PENDING="cd $(q "$ROOT") && $PSTEPS"

# ---------- completeness check: every key this run used ----------
echo "configure: keys used"
for k in $HOME_FIELDS; do echo "  $k=$(ans "$k") (answer)"; done
for k in $(printf '%s\n' "$COMMITTED_DEFAULTS" | cut -d= -f1); do
  [ "$k" = tracker.board_write ] && [ "$BOARD" = none ] && { echo "  $k= (no board)"; continue; }
  echo "  $k=$(val "$k") ($(src "$k"))"
done
for k in $MANAGED; do
  if [ "$k" = terminal_helpers ]; then echo "  $k=$HELPERS (answer)$HELPERS_NOTE"; else echo "  $k=$(val "$k") ($(src "$k"))"; fi
done
ans_all home.rules | grep -v '^$' | sed 's/^/  home.rules=/'
ans_all guard.extra | grep -v '^$' | sed 's/^/  guard.extra=/'
[ "$MULTI" = yes ] && for r in "${ROWS[@]}"; do echo "  accounts.rows=$r"; done
[ -n "$HOMES_LINES" ] && printf '%s\n' "$HOMES_LINES" | sed 's/^/  /'

# the git steps this session may not do, as one line for the person's own terminal
[ -n "$PENDING" ] && echo "pending: $PENDING"

# ---------- labels last, so a failure is the last thing said ----------
if [ "$LABELS" = 1 ]; then
  LOUT=$("$ROOT/scripts/labels" --repo "$(ans repo)" 2>&1); lrc=$?
  printf '%s\n' "$LOUT"
  if [ "$lrc" != 0 ]; then
    # the one line that does the rest: with pending git steps, those and the upload; then the labels
    UP=""; [ -n "$PSTEPS" ] && UP="$PSTEPS && git add -A && git commit -m \"Configure home\" && git push -u origin HEAD && "
    rem() { echo "cd $(q "$ROOT") && $UP$1scripts/labels"; }
    case "$LOUT" in
      *"cannot reach"*"create it on GitHub"*) why="the repo $(ans repo) was not found on GitHub. Create it (private), then run this line from your own terminal: $(rem '')" ;;
      *"cannot manage labels"*) why="this GitHub login has no permission to manage labels in $(ans repo). In a web session: on github.com/settings/installations open Claude, Configure, and add this repository with read and write access, then run scripts/labels. On a computer, run this line from your own terminal: $(rem 'gh auth refresh -s repo && ')" ;;
      *) why="GitHub refused the label step (see the line above). Once it is fixed, run this line from your own terminal: $(rem '')" ;;
    esac
    die 4 "the files are written, but the labels are NOT created: $why"
  fi
else
  echo "configure: labels not run (pass --labels, or run scripts/labels after the first push)"
fi
echo "configure: done"
