#!/usr/bin/env bash
# SessionStart hook: what a new session in this home must know first.
# Prints a short report; never blocks the session (always exits 0).
set -u
HERE=$(cd "$(dirname "$0")/.." && pwd -P)
. "$HERE/lib/config"
#   session-start --surface codex   Codex (.codex/hooks.json): also records the thread id of this tab
#                                    in .local/codex-threads/<tty> for scripts/term/term.sh
SURFACE=""
[ "${1:-}" = --surface ] && SURFACE=${2:-}
IN=$(cat 2>/dev/null) || IN=""
START_DIR=$PWD
cfg_has_home || exit 0
cd "$HOME_ROOT" || exit 0

codex_record() { # the thread id of the Codex session on this tty, with the codex pid, the cwd and the time
  # Written only with a UUID id, a codex process above this hook and that process's tty; else nothing.
  local id pid=$$ n=0 cmd cpid="" tty cwd f
  id=$(printf '%s' "$IN" | jq -r '.session_id // empty' 2>/dev/null)
  printf '%s' "$id" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$' || return 0
  while [ $n -lt 64 ]; do   # the nearest codex process above this hook
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    [ "$pid" -gt 1 ] || return 0
    cmd=$(ps -o command= -p "$pid" 2>/dev/null) || return 0
    if [ "$(printf '%s\n' "$cmd" | awk '{ n = split($1, p, "/"); print p[n]; exit }')" = codex ]; then cpid=$pid; break; fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' '); n=$((n + 1))
  done
  [ -n "$cpid" ] || return 0
  tty=$(ps -o tty= -p "$cpid" 2>/dev/null | tr -d ' ')
  case "$tty" in ''|*[!A-Za-z0-9]*) return 0 ;; esac   # "?" and "??" mean no tty
  cwd=$(printf '%s' "$IN" | jq -r '.cwd // empty' 2>/dev/null); [ -n "$cwd" ] || cwd=$START_DIR
  mkdir -p .local/codex-threads || return 0
  f=.local/codex-threads/$tty
  ( umask 077; jq -n --arg id "$id" --argjson pid "$cpid" --arg cwd "$cwd" --argjson time "$(date +%s)" \
      '{id: $id, pid: $pid, cwd: $cwd, time: $time}' > "$f.new" ) 2>/dev/null && mv "$f.new" "$f" || rm -f "$f.new"
  return 0
}
[ "$SURFACE" = codex ] && codex_record   # before the slow parts below
[ "$(git config --local core.hooksPath 2>/dev/null)" = .githooks ] || git config --local core.hooksPath .githooks 2>/dev/null
NEEDS=$(cfg labels.needs_owner needs-owner)
echo "== home: ${HOME_REPO:-?} =="
echo "Every request gets an issue first: first call scripts/home-log new --title T --body B --start (opens and claims it); last scripts/home-log finish <n> --text ..., a question or an explanation included. Work another home owns: its one issue goes there (new --repo <its repo> --ready), none here."
q=$(gh api "repos/$HOME_REPO/issues?state=open&labels=$NEEDS&per_page=20" --jq '.[] | "- \(.html_url | sub(".*/issues/"; "#")) \(.title)"' 2>/dev/null)
[ -n "$q" ] && { echo "Open owner questions ($NEEDS):"; printf '%s\n' "$q"; }
for name in $(grep -hoE '^homes\.[A-Za-z0-9_-]+\.repo' home.config .local/config 2>/dev/null | cut -d. -f2 | sort -u); do
  role=$(cfg "homes.$name.role"); [ "$role" = child ] || continue
  crepo=$(cfg "homes.$name.repo"); cpath=$(cfg "homes.$name.path")
  clabel=needs-owner
  [ -n "$cpath" ] && [ -f "$cpath/home.config" ] && clabel=$(HOME_ROOT=$cpath bash -c '. "$0"; cfg labels.needs_owner needs-owner' "$HERE/lib/config")
  cq=$(gh api "repos/$crepo/issues?state=open&labels=$clabel&per_page=20" --jq '.[] | "- \(.html_url | sub("https://github.com/"; "") | sub("/issues/"; "#")) \(.title)"' 2>/dev/null)
  [ -n "$cq" ] && { echo "Open questions in $name ($clabel):"; printf '%s\n' "$cq"; }
done
( "$HERE/home-sweep" > "$HOME_ROOT/.local/sweep.out" 2>/dev/null ) & sp=$!
i=0; while kill -0 "$sp" 2>/dev/null && [ $i -lt 40 ]; do sleep 1; i=$((i + 1)); done
if kill -0 "$sp" 2>/dev/null; then kill "$sp" 2>/dev/null; echo "sweep: timed out (run scripts/home-sweep)"; fi
# base-ahead and drift lines always show; up to 12 other findings follow.
[ -s .local/sweep.out ] && { echo "Sweep:"; grep -E '^SWEEP (base-ahead|drift) ' .local/sweep.out; grep -vE '^SWEEP (base-ahead|drift) ' .local/sweep.out | sed -n '1,12p'; }
verdict=$("$HERE/limits" 2>/dev/null | cut -d' ' -f1)
echo "limits: $(cfg limits.mode none) (${verdict:-ok})"
if [ "$(cfg dreams.mode manual)" = daily ]; then
  last=$(gh api "repos/$HOME_REPO/issues?state=open&labels=dreams&per_page=1" --jq '.[0].updated_at // empty' 2>/dev/null)
  if [ -z "$last" ] || [ "$(( $(date -u +%s) - $(date -u -j -f %Y-%m-%dT%H:%M:%SZ "$last" +%s 2>/dev/null || date -u -d "$last" +%s) ))" -gt 86400 ]; then
    echo "dreams: due (run the dreams skill in the background)"
  fi
fi
exit 0
