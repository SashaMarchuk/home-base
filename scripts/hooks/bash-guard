#!/usr/bin/env bash
# PreToolUse hook for Bash. Blocks (exit 2, reason on stderr):
#   pkill, killall, kill with anything but numeric PIDs; gh auth switch;
#   a force push to the default branch; gh repo delete; a repo visibility change;
#   git push base ... ; and every extended regex in guard.extra (home.config).
# A kill of exact PIDs passes silently only when every PID is the session's own: a
# descendant of the agent process above this hook (claude or codex), or a live entry of
# .local/registry.json (not an adopted tab; same tty; command line still holds its match).
# Any other PID: Claude Code is answered "ask" (JSON on stdout, exit 0; the user confirms),
# Codex is refused (exit 2). Ownership that cannot be determined is refused. Signal 0 only
# probes and always passes. A command that holds the word kill where the guard cannot read it
# as "kill [signal] <PIDs>" (behind a wrapper such as timeout, nice, trap or a function body)
# is refused on every surface (never asked: the agent restates it, or passes text through a file). Text is let through: after
# echo, printf, grep, egrep, fgrep, rg, git, gh, cat, man, which, type, ls, cd and home-log,
# and where a plain word follows kill and no bare number or variable comes after it.
# Not seen: a kill inside a script file or another interpreter. The agent session is the
# nearest process above the hook whose command is named exactly claude or codex.
# The command is .tool_input.command (Claude Code, Codex Bash) or .tool_input.cmd
# (a string or a list of words; Codex exec_command).
# Usage outside a hook: echo '{"tool_input":{"command":"..."}}' | bash-guard
set -u
HERE=$(cd "$(dirname "$0")/.." && pwd -P)
. "$HERE/lib/config"
# A list "<shell> [options] -c <script>" is checked as its script (options up to the first -...c).
CMD=$(jq -r '.tool_input.command // .tool_input.cmd // empty
  | if type == "array" then
      (. as $a | (if length >= 3 and (.[0] | test("(^|/)(ba|z|k|da)?sh$"))
        then (first(range(1; length) | select($a[.] | test("^-[A-Za-z]*c$"))) // null) else null end) as $i
      | if $i != null and ($a[1:$i] | all(startswith("-"))) then $a[$i + 1 + (if $a[$i + 1] == "--" then 1 else 0 end):] else $a end | join(" "))
    else . end' 2>/dev/null)
[ -n "$CMD" ] || exit 0
block() { echo "bash-guard: blocked: $1. $2" >&2; exit 2; }
# pkill and killall anywhere (a path prefix, bash -c, sudo, xargs) are kills by pattern.
printf '%s\n' "$CMD" | grep -qE '(^|[^A-Za-z0-9_.-])(pkill|killall)([^A-Za-z0-9_-]|$)' && block "kill by pattern" "Kill exact PIDs only (rule 9)."
# Kill with a computed PID list is a kill by pattern.
printf '%s\n' "$CMD" | grep -qE '(^|[;&|([:space:]])kill([[:space:]]+-[^[:space:]]+)*[[:space:]]+[^;&|]*(\$\(|`|pgrep|pidof)' && block "kill with a computed PID list" "Kill exact numeric PIDs only (rule 9)."
printf '%s\n' "$CMD" | grep -qE 'xargs([[:space:]]+(-[^[:space:]]+|[0-9]+|\{\}))*[[:space:]]+([^[:space:]]*/)?kill([[:space:]]|$)' && block "kill through xargs" "Kill exact numeric PIDs only (rule 9)."
# Look at each simple command separately.
# A single & outside a redirection ends a command too (one at a time, so "a&b&c" is three commands);
# sh -c "..." and eval "..." are read as their script, with a path before the shell and "--" after -c.
# Skipped before the command word: ( ! {, a redirection, VAR=value, a backslash, the wrappers and
# keywords below (with a path), and quotes around the word kill.
segs=$(printf '%s\n' "$CMD" | sed -E 's/(\|\||&&|;|\||\$\(|`)/\n/g' | sed -E -e ':a' -e 's/(^|[^<>&])&([^>&]|$)/\1\n\2/' -e 'ta')
PIDS=""; UNREAD=""
while IFS= read -r s; do
  s=$(printf '%s' "$s" | sed -E 's/^[[:space:]]*//; :k
    s/^[(!{]+[[:space:]]*//; tk
    s/^[0-9]*[<>]{1,2}&?[[:space:]]*[^[:space:]]+[[:space:]]+//; tk
    s/^[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+//; tk
    s#^([^[:space:]]*/)?(sudo([[:space:]]+-[A-Za-z]+)*|command([[:space:]]+-p)?|builtin|exec|env|nohup|time)[[:space:]]+##; tk
    s/^(do|then|else|elif|if|while|until)[[:space:]]+//; tk
    s#^(([^[:space:]]*/)?(ba|z|k|da)?sh([[:space:]]+-[A-Za-z]+)*[[:space:]]+-[A-Za-z]*c([[:space:]]+--)?|eval)[[:space:]]+["'"'"']?##; tk
    s/^\\//; tk
    s#^"(([^[:space:]"]*/)?kill)"([[:space:]]|$)#\1\3#; tk
    s#^'"'"'(([^[:space:]'"'"']*/)?kill)'"'"'([[:space:]]|$)#\1\3#; tk
    s#^[^[:space:]]*/(kill|pkill|killall)([[:space:]]|$)#\1\2#')
  [ -n "$s" ] || continue
  case "$s" in
    pkill*|killall*) block "kill by pattern" "Kill exact PIDs only (rule 9)." ;;
  esac
  if printf '%s' "$s" | grep -qE '^kill([[:space:]]|$)'; then
    args=$(printf '%s' "$s" | sed -E 's/^kill[[:space:]]*//; s/[0-9]*>&[0-9]+//g; s/[0-9]*[<>]{1,2}[[:space:]]*[^[:space:]]+//g; s/["'"'"']+([[:space:]]|$)/\1/g')
    # One signal option may come first; every other argument is a PID: a single positive
    # number above 1. Negative numbers (process groups), 0, 1 and -1 kill more than one process.
    # Options end at the first PID, as in the shell: a later "-x" is a group or a mistake.
    # probe=1: signal 0 or a signal listing; it ends nothing, so its PIDs need no owner.
    skip=0; sig=0; dd=0; probe=0; pids=""
    for a in $args; do
      [ "$skip" = 1 ] && { skip=0; [ "$a" = 0 ] && probe=1; continue; }
      if [ "$dd" = 0 ]; then
        case "$a" in
          --) dd=1; continue ;;
          -l|-L) [ "$sig" = 0 ] && { sig=1; probe=1; continue; } ;;
          -s|-n) [ "$sig" = 0 ] && { sig=1; skip=1; continue; } ;;
          -[0-9]*|-[A-Za-z]*) [ "$sig" = 0 ] && { sig=1; [ "$a" = -0 ] && probe=1; continue; } ;;
        esac
      fi
      case "$a" in
        ''|*[!0-9]*|0|1|0*) block "kill with '$a'" "Kill exact numeric PIDs only, one process each (rule 9)." ;;
      esac
      pids="$pids $a"; dd=1
    done
    [ "$probe" = 1 ] || PIDS="$PIDS$pids"
  elif q=$(printf '%s' "$s" | tr -d "\"'") && printf '%s' "$q" | grep -qE '(^|[[:space:]])([^[:space:]]*/)?\\?kill([[:space:]]|$)'; then
    # The word kill inside another command. Text passes: after a command of the list below, or when a
    # plain word follows kill and no bare number or variable comes after it. Anything else is a kill
    # the guard cannot read (timeout 5 kill N, trap, a function body, xargs): asked or refused below.
    case "$(printf '%s\n' "$q" | awk '{ n = split($1, a, "/"); print a[n]; exit }')" in
      echo|printf|grep|egrep|fgrep|rg|git|gh|cat|man|which|type|ls|cd|home-log) ;;
      xargs) UNREAD="$UNREAD'$(printf '%s' "$s" | cut -c1-80)', " ;;
      *) printf '%s\n' "$q" | awk '{ k = 0
             for (i = 1; i <= NF; i++) { w = $i; sub(/^.*\//, "", w); sub(/^\\/, "", w); if (w == "kill") { k = i; break } }
             if (!k || k == NF || $(k + 1) !~ /^[A-Za-z][A-Za-z,.:;!?-]*$/) exit 1
             for (i = k + 1; i <= NF; i++) if ($i ~ /^[0-9]+$/ || index($i, "$") > 0) exit 1
             exit 0 }' || UNREAD="$UNREAD'$(printf '%s' "$s" | cut -c1-80)', " ;;
    esac
  fi
  printf '%s' "$s" | grep -qE '^gh[[:space:]]+auth[[:space:]]+switch' && block "gh auth switch" "Use the account this home's config names (rule 12)."
  printf '%s' "$s" | grep -qE '^gh[[:space:]]+repo[[:space:]]+delete' && block "gh repo delete" "Deleting a repository needs the owner."
  printf '%s' "$s" | grep -qE '^gh[[:space:]]+repo[[:space:]]+edit[[:space:]].*--visibility' && block "visibility change" "Changing repository visibility needs the owner."
  printf '%s' "$s" | grep -qE '^gh[[:space:]]+api.*(-f|-F|--field|--raw-field)[[:space:]]+(private|visibility)=' && block "visibility change" "Changing repository visibility needs the owner."
  printf '%s' "$s" | grep -qE '^git([[:space:]]+-[cC][[:space:]]+[^[:space:]]+)*[[:space:]]+push[[:space:]]+(.*[[:space:]])?base([[:space:]]|$)' && block "git push base" "Never push to the base from a home; fix the base in its own checkout."
  if printf '%s' "$s" | grep -qE '^git([[:space:]]+-[cC][[:space:]]+[^[:space:]]+)*[[:space:]]+push([[:space:]]|$)' && printf '%s' "$s" | grep -qE '(^|[[:space:]])(-f|--force|--force-with-lease(=[^[:space:]]*)?|\+[^[:space:]]+)([[:space:]]|$)'; then
    if printf '%s' "$s" | grep -qE '(^|[[:space:]:+])(main|master)([[:space:]]|$)' || ! printf '%s' "$s" | grep -qE 'push[[:space:]]+(-[^[:space:]]+[[:space:]]+)*[^-[:space:]][^[:space:]]*[[:space:]]+[^-[:space:]]'; then
      block "force push to the default branch" "Never force-push main."
    fi
  fi
done <<<"$segs"
while IFS= read -r re; do
  [ -n "$re" ] || continue
  printf '%s\n' "$CMD" | grep -qE -- "$re" && block "matches guard.extra '$re'" "This home blocks it; ask the owner."
done < <(cfg_all guard.extra)
[ -n "$PIDS$UNREAD" ] || exit 0

# ---- a kill of exact PIDs: is every one of them this session's own process? (and a kill that could not be read)
pcmd() { ps -o command= -p "$1" 2>/dev/null; }
above() { # above <pid>: its ancestors, nearest first, one "<pid> <first word of the command, no path>" per line
  local p=$1 n=0 c
  while [ $n -lt 64 ]; do
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    case "$p" in ''|*[!0-9]*|0|1) return 0 ;; esac
    c=$(pcmd "$p") || return 0
    printf '%s %s\n' "$p" "$(printf '%s\n' "$c" | awk '{ n = split($1, a, "/"); print a[n]; exit }')"
    n=$((n + 1))
  done
}
in_registry() { # in_registry <pid> <its command>: 0 a live entry of this home, 1 not, 2 the registry cannot be read
  local reg="$HOME_ROOT/.local/registry.json" e tty match
  [ -f "$reg" ] || return 1
  e=$(jq -r --arg p "$1" 'if type != "array" then error("not a list") else . end
    | [.[] | select((.pid | tostring) == $p and .closed == null and .adopted != true)] | last
    | if . == null then "" else "\(.tty // "")\t\(.match // "")" end' "$reg" 2>/dev/null) || return 2
  IFS=$'\t' read -r tty match <<EOF
$e
EOF
  [ -n "$tty" ] && [ -n "$match" ] || return 1
  [ "$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' ')" = "$tty" ] || return 1
  case "$2" in *"$match"*) return 0 ;; esac
  return 1
}
REFUSE="Run nothing instead; ask the owner to run the kill (rule 9)."
[ -n "$(pcmd $$)" ] || block "kill while ps does not work" "Ownership cannot be checked. $REFUSE"
agent=$(above $$ | awk '$2 == "claude" || $2 == "codex" { print; exit }')
AGENT_PID=${agent%% *}; AGENT_NAME=${agent#* }
foreign=""
for p in $PIDS; do
  c=$(pcmd "$p"); [ -n "$c" ] || block "kill $p" "No process has PID $p; there is nothing to kill."
  if [ -n "$AGENT_PID" ] && above "$p" | grep -q "^$AGENT_PID "; then continue; fi
  in_registry "$p" "$c"
  case $? in
    0) continue ;;
    2) block "kill $p while .local/registry.json cannot be read" "Ownership cannot be checked. $REFUSE" ;;
  esac
  [ -n "$AGENT_PID" ] || block "kill $p with no agent process above this hook" "Ownership cannot be checked. $REFUSE"
  foreign="$foreign$p ($(printf '%s' "$c" | cut -c1-80)), "
done
[ -n "$foreign$UNREAD" ] || exit 0
foreign=${foreign%, }; UNREAD=${UNREAD%, }
# A form the guard cannot read is refused on every surface, never asked: a confirmation would stall a
# session nobody watches, and the agent can restate it (the kill on its own, or text through a file).
[ -z "$UNREAD" ] || block "${foreign:+kill of a process this session did not start: PID $foreign; and }a kill the guard cannot read: $UNREAD" \
  "Write it as kill <PID> on its own. If the word is only text (a message, test data), pass that text through a file instead of the command line (rule 9)."
why="this session did not start PID $foreign"
if [ "$AGENT_NAME" = claude ] && [ "${BASH_GUARD_SURFACE:-}" != codex ] && [ -z "${CODEX_THREAD_ID:-}" ]; then
  jq -nc --arg r "bash-guard: $why. Confirm only if exactly this process must end (rule 9)." \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
  exit 0
fi
block "kill of a process this session did not start: PID $foreign" "$REFUSE"
