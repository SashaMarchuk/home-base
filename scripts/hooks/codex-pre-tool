#!/usr/bin/env bash
# PreToolUse hook for Codex (.codex/hooks.json, matcher ".*"). Sends each tool
# call to the guard for its tool name: shell calls (Bash with .tool_input.command,
# exec_command with .tool_input.cmd) to bash-guard, apply_patch to
# sensitive-guard. Every other tool passes untouched (exit 0).
set -u
HERE=$(cd "$(dirname "$0")" && pwd -P)
IN=$(cat)
case "$(printf '%s' "$IN" | jq -r '.tool_name // empty' 2>/dev/null)" in
  Bash|exec_command|shell|local_shell) printf '%s' "$IN" | "$HERE/bash-guard" ;;
  apply_patch) printf '%s' "$IN" | "$HERE/sensitive-guard" ;;
  *) exit 0 ;;
esac
