#!/usr/bin/env bash
# SessionEnd hook. One case only: this session holds a claim (.local/runs/<n>)
# whose comment is still active and has no final text. It rewrites that comment
# as a stub (session id, resume command) and adds needs-summary. Never blocks.
#   session-end --surface claude Claude Code (session_id on stdin or CLAUDE_CODE_SESSION_ID):
#                                "claude --resume <id>"
#   session-end --surface codex  Codex (.codex/hooks.json): "codex resume <id>", and the
#                                GitHub work runs in a detached child so the hook returns
#                                at once (Codex stops a SessionEnd hook after a few seconds).
#   session-end                  as claude, but a set CODEX_THREAD_ID makes it "codex resume".
# The claim is found by the hook's session id and by CODEX_THREAD_ID (home-log stores the
# Codex thread id when it is set); a claim found by CODEX_THREAD_ID resumes with
# "codex resume <thread id>".
set -u
HERE=$(cd "$(dirname "$0")/.." && pwd -P)
. "$HERE/lib/config"
SURFACE=""
[ "${1:-}" = --surface ] && SURFACE=${2:-}
IN=$(cat 2>/dev/null)
SID=$(printf '%s' "$IN" | jq -r '.session_id // empty' 2>/dev/null)
[ "$SURFACE" = codex ] || [ -n "$SID" ] || SID=${CLAUDE_CODE_SESSION_ID:-}
TID=${CODEX_THREAD_ID:-}
[ -n "$SID$TID" ] || exit 0
CWD=$(printf '%s' "$IN" | jq -r '.cwd // empty' 2>/dev/null); [ -n "$CWD" ] || CWD=$PWD
RESUME_CMD="claude --resume"
{ [ "$SURFACE" = codex ] || { [ -z "$SURFACE" ] && [ -n "$TID" ]; }; } && RESUME_CMD="codex resume"
stubs() {
  local f repo n run cmd
  for f in "$HOME_ROOT"/.local/runs/*; do
    [ -f "$f" ] || continue
    run=$(sed -n 's/^run=//p' "$f")
    if [ -n "$SID" ] && [ "$run" = "$SID" ]; then cmd=$RESUME_CMD
    elif [ -n "$TID" ] && [ "$run" = "$TID" ]; then cmd="codex resume"
    else continue; fi
    repo=$(sed -n 's/^repo=//p' "$f"); n=${f##*/}; n=${n##*_}
    "$HERE/home-log" stub "$n" --repo "$repo" --run-id "$run" --resume "cd ${CWD/#$HOME/~} && $cmd $run" >/dev/null 2>&1 || true
  done
}
if [ "$SURFACE" = codex ]; then
  # Detached: own session (setsid), no open stdin/stdout/stderr, so the hook returns at once.
  export -f stubs; export HERE SID TID CWD RESUME_CMD
  perl -MPOSIX -e 'exit 0 if fork; POSIX::setsid(); exec @ARGV' bash -c stubs </dev/null >/dev/null 2>&1
  exit 0
fi
stubs
exit 0
