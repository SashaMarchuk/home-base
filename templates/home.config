# home.config: committed settings of this home, shared by everyone who uses it.
# Flat "key=value" lines. A line that starts with '#' is a comment; put comments
# on their own line, never after a value. .local/config (gitignored, per machine)
# overrides any key here. scripts/configure writes this file from the owner's
# answers; every active line below shows the default.

# This home's GitHub repo, <owner>/<name>.
repo=

# Language of files, briefs and worker prompts / language used with the owner.
lang.files=en
lang.owner=en

# The task queue. Only scripts/home-log and scripts/home-sweep talk to it.
tracker.backend=github
# An external team board that issues link to, never mirror: none | <board name, lower case>
tracker.board=none
# What agents may do on that board: ask-first | yes | read-only (empty when there is no board)
tracker.board_write=

# The label that marks a question or blocker waiting on the owner.
labels.needs_owner=needs-owner

# A worker's question while the owner is away: park | continue.
#   park: the worker parks with its question and stops.
#   continue: it takes the reversible default, stores the question and keeps going.
questions.worker_away=park

# The tab of a session that has finished (its final record written, nothing waiting, an empty box): ask | auto.
#   ask: the orchestrator lists it as closable and closes it on the owner's word.
#   auto: the orchestrator closes it by itself. Used with terminal helpers on.
term.close_finished=ask

# Extra command patterns the bash guard blocks in this home. Repeatable:
# one guard.extra=<pattern> line per pattern.
#@guard.extra

# Where the base repo lives. base-update, session-start and the sweep add the
# "base" remote from it when a clone has none, always with pushing disabled.
base.url=

# Related homes. Repeatable per <name>; role is parent | child | peer.
#   homes.<name>.repo=<owner>/<repo>
#   homes.<name>.path=~/<path of its local clone>
#   homes.<name>.role=child
#   homes.<name>.topics=<comma-separated words: a request about them belongs to that home>
# The orchestrator routes a request to the home whose topics it matches; more than
# one match is one question to the owner. Topics live only in this file.
#@homes

# Limits: none | soft | hard, and the threshold in percent.
#   soft: at the threshold start nothing new; running tasks finish.
#   hard: at the threshold park every running task at once; start nothing.
limits.mode=none
limits.threshold=90

# Proactivity: assigned | off | watch. watch also checks the sources every N minutes.
proactivity.mode=assigned
proactivity.sources=
proactivity.every_minutes=60

# Dreams: manual | daily, and the window of the first run in days.
dreams.mode=manual
dreams.first_window_days=14

# Where a confirmed personal fact goes: none | <MCP server name>.
facts.sink=none

# Voice interviews (orchestrate skill, section 9). Empty: the default.
#   voice.interview_plugin: the plugin or skill that makes the interview package
#     when it is installed; empty: the orchestrator writes the package by hand.
#   voice.backchannels: comma list of AI-only words scripts/voice-collect drops;
#     when set it replaces the default English list (uh-huh, mm-hm, mhm, yeah, yes, ok, ...).
voice.interview_plugin=
voice.backchannels=

# Age in hours after which a silent claim is reported by the sweep.
sweep.stale_hours=6
# How many days back the sweep looks at closed issues and merged pull requests.
sweep.lookback_days=14

# Terminal helpers (used only with terminal_helpers=on). Unset keys use the defaults shown.
#   term.max_workers=4                   open worker tabs allowed at once
#   term.min_free_pct=20                 refuse to open a tab below this free-memory percentage (0 = no check)
#   term.login_dialog_re=<regex>         extended regex (case-insensitive) a dialog must match to be
#                                        answered after a passed login check (default: log in, sign in,
#                                        authenticate, session expired, re-auth)

# Machine keys. They belong in .local/config (gitignored), never here:
#   gh.config_dir=<dir>                  exported as GH_CONFIG_DIR by every script
#   terminal_helpers=off                 on | off; on only after the device check
#   transcripts.paths=~/.claude/projects,~/.codex/sessions
#   transcripts.exclude=                 working-directory prefixes Dreams skips
#   limits.reader=none                   none | path of an executable printing "<5h%> <weekly%> <reset>"
#   launch.profile.orchestrator=         launch profile of the orchestrator
#   launch.profile.worker=               launch profile of workers
#   launch.model=                        a model alias, never a pinned version
#   launch.command=claude                the command a new tab runs (one word)
#   launch.profile_flag=                 flag that passes launch.profile.* to it; empty: none
#   guard.private_values=                path of a gitignored file of literal values to block
#   guard.boundary_terms=                path of a terms file (w:/n: lines) of the other domain
